{
  "name": "inktatto",
  "version": "1.0.0",
  "private": true,
  "description": "INKTATTO - aplicación web y API",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/prepare-local.js && concurrently --kill-others --names API,WEB --prefix-colors blue,green \"npm run start:dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "test:e2e": "npm run test:e2e --workspace backend",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
