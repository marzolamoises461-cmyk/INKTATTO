NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=inktatto_app
DB_PASSWORD=inktatto_local_pass
DB_DATABASE=inktatto_db
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRATION=3600
FRONTEND_URL=http://localhost:3000
# Wompi Colombia. Leave all credential values empty to keep real checkout disabled.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# SMTP configuration is required for password recovery and to deliver queued notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
STUDIO_EMAIL=
# Private S3-compatible storage for reference images (AWS S3, Cloudflare R2, or MinIO).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
